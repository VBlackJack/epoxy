{
  "name": "epoxy",
  "version": "1.0.0",
  "description": "Atari Lynx II inspired grid puzzle game",
  "author": "Julien Bombled",
  "license": "Apache-2.0",
  "type": "module",
  "scripts": {
    "dev": "vite",
    "build": "tsc && vite build",
    "preview": "vite preview",
    "typecheck": "tsc --noEmit && tsc -p tsconfig.tools.json --noEmit",
    "test": "vitest run",
    "test:watch": "vitest",
    "report:levels": "vitest run --config vitest.report.config.ts tools/levelMetrics.report.ts",
    "report:pieces": "vitest run --config vitest.report.config.ts tools/pieceProbe.report.ts"
  },
  "devDependencies": {
    "@types/node": "^24.19.2",
    "typescript": "^5.6.3",
    "vite": "^7.3.7",
    "vitest": "^5.0.5"
  }
}

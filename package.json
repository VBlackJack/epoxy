{
  "name": "epoxy",
  "version": "2.7.0",
  "description": "Atari Lynx II inspired grid puzzle game",
  "author": "Julien Bombled",
  "license": "Apache-2.0",
  "type": "module",
  "scripts": {
    "dev": "vite",
    "build": "tsc && vite build",
    "preview": "vite preview",
    "typecheck": "tsc --noEmit && tsc -p tsconfig.tools.json --noEmit",
    "test": "vitest run",
    "test:watch": "vitest",
    "report:levels": "vitest run --config vitest.report.config.ts tools/levelMetrics.report.ts",
    "report:pieces": "vitest run --config vitest.report.config.ts tools/pieceProbe.report.ts",
    "report:originality": "vitest run --config vitest.report.config.ts tools/originalityStudy.report.ts",
    "report:study": "vitest run --config vitest.report.config.ts tools/communityStudy.report.ts",
    "report:dependencies": "vitest run --config vitest.report.config.ts tools/dependencyStudy.report.ts",
    "mine:pieces": "vitest run --config vitest.report.config.ts tools/pieceMiner.report.ts",
    "route:campaign": "vitest run --config vitest.report.config.ts tools/campaignRoute.report.ts",
    "forge:sokoban": "vitest run --config vitest.report.config.ts tools/sokobanForge.report.ts",
    "import:sokoban": "vitest run --config vitest.report.config.ts tools/sokobanImport.report.ts",
    "annotate:pieces": "vitest run --config vitest.report.config.ts tools/annotatePieces.report.ts",
    "report:hub": "vitest run --config vitest.report.config.ts tools/hubAreaStudy.report.ts"
  },
  "devDependencies": {
    "@types/node": "^24.19.2",
    "typescript": "^5.6.3",
    "vite": "^7.3.7",
    "vitest": "^5.0.5"
  }
}

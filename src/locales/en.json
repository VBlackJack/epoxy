  "levels": {
    "level_1": {
      "title": "Lesson 1: Silicon Step",
      "hint": "The green key can be used as many times as you want! Collect all 8 chips to open the socket to the exit."
    },
    "level_2": {
      "title": "Bridge Over Troubled Water",
      "hint": "Push dirt blocks into water to build a solid bridge, then grab the Flippers in the south!"
    },
    "level_3": {
      "title": "Skating Rink & Corner Banks",
      "hint": "Use the banked ice corners to ricochet to the Ice Skates in the southeast, then collect the chips freely."
    },
    "level_4": {
      "title": "Conveyor Chaos & The Thief",
      "hint": "Suction and Fire Boots protect you, but the Thief guarding the south passage will confiscate all your boots!"
    },
    "level_5": {
      "title": "Beetle & Tank Command",
      "hint": "Step on the blue button to reverse the Tank onto the brown button and hold the trap open!"
    },
    "level_6": {
      "title": "Toggle Matrix & Clone Factory",
      "hint": "Green buttons toggle walls open and shut. The red button clones dirt blocks to bridge the water channel!"
    },
    "level_7": {
      "title": "Quantum Teleporters & Illusions",
      "hint": "Some blue walls are illusions! Security creatures cannot step onto gravel."
    },
    "level_8": {
      "title": "Epoxy Core: Elemental Gauntlet",
      "hint": "Master all four elemental boots before crossing the thieves to unlock the final core!"
    },
    "level_9": {
      "title": "Laser Panels & Phantom Walls",
      "hint": "Thin panel walls block only one edge of a tile. Probe the appearing walls to discover the gaps!"
    },
    "level_10": {
      "title": "Lynx Grandmaster",
      "hint": "Combine the green master key, teleporters, and dirt bridges to gather all 8 master chips!"
    },
    "level_11": {
      "title": "Cryogenic Rings",
      "hint": "Grab the green master key in the north and Ice Skates in the south center to conquer the double ice spiral!"
    },
    "level_12": {
      "title": "High-Voltage Chambers",
      "hint": "Each locked chamber holds the key to the next. Watch out for the Pink Ball and Walker!"
    },
    "level_13": {
      "title": "Magma Core",
      "hint": "Equip the Fire Boots and Flippers in the north before crossing the furnace and water moat!"
    },
    "level_14": {
      "title": "Synchronous Matrix",
      "hint": "Green buttons on the left and right alternate the toggle corridors to unlock all 8 chips."
    },
    "level_15": {
      "title": "Citadel of Epoxy",
      "hint": "The ultimate test: combine elemental boots, keys, and the central ice vault to collect all 10 chips!"
    },
